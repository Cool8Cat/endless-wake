{
  "name": "endless-wake",
  "version": "4.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "typecheck": "tsc --noEmit",
    "build": "vinext build",
    "start": "vinext start",
    "test": "tsc --noEmit && vinext build && node --test tests/service-worker.test.mjs tests/rendered-html.test.mjs tests/voxel-terrain-mesh.test.mjs tests/voxel-loadout.test.mjs tests/voxel-world.test.mjs tests/voxel-runtime.test.mjs tests/voxel-models.test.mjs",
    "build:pages": "vite build --config vite.pages.config.ts && node --test tests/pages-output.test.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
